# ==============================================================================
# EXCLUSIVE WINTER ARC CHALLENGE - ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to '.env' or '.env.local' and fill in your credentials.
# Do NOT commit '.env' or your secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION SETTINGS
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
# Canonical public URL of the application (used for OAuth redirects & callbacks)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. SUPABASE (DATABASE, AUTH, REALTIME & STORAGE)
# ------------------------------------------------------------------------------
# Get these from your Supabase Dashboard: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Service Role Key (Keep secret! Used server-side only for admin actions & cron jobs)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Realtime sync latency target threshold (milliseconds)
NEXT_PUBLIC_REALTIME_SYNC_INTERVAL_MS=3000

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION PROVIDERS
# ------------------------------------------------------------------------------
# A) Google OAuth
# Obtain from Google Cloud Console -> APIs & Services -> Credentials
# Authorized redirect URI: https://<your-project-id>.supabase.co/auth/v1/callback
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# B) Telegram Login Widget / Bot
# Create a bot via @BotFather on Telegram, configure /setdomain to your app domain
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=WinterArcChallengeBot

# ------------------------------------------------------------------------------
# 4. GOOGLE GEMINI AI (DIET & NUTRITION ENGINE)
# ------------------------------------------------------------------------------
# Get your API key from Google AI Studio: https://aistudio.google.com/
# Used for instant meal parsing, calorie calculation, and surplus/deficit analysis
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere
# Recommended model: gemini-2.5-flash or gemini-1.5-flash for real-time speed (<1s)
GEMINI_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# 5. GOOGLE FIT API (STEP TRACKER & SMARTWATCH METRICS)
# ------------------------------------------------------------------------------
# Enable Fitness API in Google Cloud Console
GOOGLE_FIT_CLIENT_ID=your-google-fit-client-id.apps.googleusercontent.com
GOOGLE_FIT_CLIENT_SECRET=your-google-fit-client-secret
GOOGLE_FIT_REDIRECT_URI=http://localhost:3000/api/integrations/google-fit/callback

# ------------------------------------------------------------------------------
# 6. WINTER ARC CHALLENGE RULE ENGINE
# ------------------------------------------------------------------------------
# Challenge start date (ISO 8601: YYYY-MM-DD)
NEXT_PUBLIC_WINTER_ARC_START_DATE=2026-10-01
# Total duration of the challenge in days
NEXT_PUBLIC_WINTER_ARC_TOTAL_DAYS=90
# Minimum commitments required to unlock challenge entry
NEXT_PUBLIC_MIN_COMMITMENTS=5
# Maximum commitments allowed
NEXT_PUBLIC_MAX_COMMITMENTS=20
# Daily cutoff hour for task completion lock (24h format: 0 = midnight 12:00 AM)
TASK_LOCK_HOUR=0
# Morning check-in recognition cutoff hour (12:00 PM noon)
MORNING_RECOGNITION_HOUR=12

# ------------------------------------------------------------------------------
# 7. STORAGE BUCKETS (SUPABASE STORAGE)
# ------------------------------------------------------------------------------
# Supabase storage bucket names for screenshot/proof uploads
NEXT_PUBLIC_STORAGE_BUCKET_SCREENSHOTS=screentime-proofs
NEXT_PUBLIC_STORAGE_BUCKET_AVATARS=avatars
